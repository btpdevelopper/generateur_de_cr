# Express API config

PORT=8080
# Allowed CORS origin for the client (defaults to permissive in dev).
CORS_ORIGIN=http://localhost:5173

# Firebase Admin credentials. Use ONE of the following:
#   1) Path to a service-account JSON file:
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
#   2) Or the service-account JSON inline (single line):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

FIREBASE_PROJECT_ID=

# --- Local development against the Firebase Emulator Suite ---
# When set, the Admin SDK talks to the local emulator instead of production.
# FIRESTORE_EMULATOR_HOST=localhost:8081
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
